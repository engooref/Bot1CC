{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Bot TypeScript",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        // active l’ESM loader de ts-node
        "--loader", "ts-node/esm",
        "--inspect-brk=0.0.0.0:9229"
      ],
      "env": {
        // permet de charger automatiquement les sourcemaps
        "TS_NODE_TRANSPILE_ONLY": "true",
        "TS_NODE_ESM": "true"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
