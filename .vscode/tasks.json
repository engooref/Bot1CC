{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bot: Lancer le bot de test (tout faire)",
      "type": "shell",
      "command": "./scripts/dev.sh start",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\dev.ps1 start"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
