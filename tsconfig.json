{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",                  // tout ton code TS
  ],
  "exclude": ["node_modules", "dist"]
}
