# Modèle de configuration de TEST LOCAL. Valeurs factices : aucun vrai secret.
# scripts/dev.* le copie vers .env (ignoré par git) s'il n'existe pas.
# Les lignes à remplir à la main (DISCORD_TOKEN, GUILD_ID, ROLE_ID) viennent d'un bot et d'un serveur Discord de TEST, jamais de la production.
# Variables relevées dans docs/prise-en-main.md : aucune variable nouvelle.

# « prod » veut seulement dire « code compilé » : sans cela, l'ORM cherche les entités en TypeScript (src/mikro-orm.config.ts).
NODE_ENV=prod
LOG_MIKRO=false

# Bot Discord de TEST (portail développeur : une seconde application) et serveur de TEST.
DISCORD_TOKEN=
GUILD_ID=
# Ton identifiant Discord (commande /db, création de salons d'événements).
ENGOO_ID=
# ID du rôle « Membre » du serveur de TEST (le bot l'initialise encore depuis cette variable).
ROLE_ID=

# Base partagée avec le site de développement : MySQL de Site1CC, publiée sur le port 3308 de ta machine.
MYSQL_URL=mysql://app:app@host.docker.internal:3308/site1cc

# Site de développement (Site1CC, scripts/dev.* start) : le bot y lit ses paramètres.
URL_SITE=http://host.docker.internal:8000
APP_URL=http://localhost:8000

# Liaison bot <-> site. Mêmes valeurs à mettre dans le .env de Site1CC : `scripts/dev.sh site-config` les affiche.
BOT_TOKEN=dev-bot-token-factice
BOT_SHARED_SECRET=dev-bot-secret-factice-0123456789abcdef
PORT=3001

# Volontairement vides en test : sans GITHUB_TOKEN, `/github issue` ne peut créer aucun ticket sur les dépôts publics.
GITHUB_TOKEN=
VOICE_CREATE_CATEGORY_ID=
