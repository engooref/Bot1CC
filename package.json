{
    "name": "bot-1cc",
    "version": "1.0.0",
    "description": "Bot Discord du 1CC",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "build": "node scripts/clean-build.mjs && tsc",
        "start": "npm run build && node dist/src/index.js",
        "mikro-orm": "mikro-orm-esm",
        "migrate:create": "npm run build && npm run mikro-orm -- migration:create",
        "migrate:up": "npm run build && npm run mikro-orm -- migration:up",
        "migrate:down": "npm run build && npm run mikro-orm -- migration:down",
        "test:diplomatie": "npm run build && node --test tests/diplomatie.test.mjs",
        "test:recrutement": "npm run build && node --test tests/recrutement.test.mjs tests/guild-members.test.mjs tests/young-account.test.mjs",
        "test:parrainage": "npm run build && node --test tests/parrainage.test.mjs tests/guild-members.test.mjs",
        "test:github": "npm run build && node --test tests/github-labels.test.mjs tests/github-ticket.test.mjs",
        "test:all": "npm run build && node --test \"tests/*.test.mjs\""
    },
    "dependencies": {
        "@discord-player/extractor": "^7.1.0",
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.18.0",
        "@mikro-orm/core": "^6.4.15",
        "@mikro-orm/migrations": "^6.4.13",
        "@mikro-orm/mysql": "^6.4.13",
        "@mikro-orm/reflection": "^6.4.13",
        "canvas": "^3.1.0",
        "cron": "^4.3.1",
        "crypto": "^1.0.1",
        "date-fns": "^4.1.0",
        "discord-api-types": "^0.38.8",
        "discord-player": "^7.1.0",
        "discord-player-youtubei": "^1.5.0",
        "discord.js": "^14.21.0",
        "dotenv": "^16.0.0",
        "express": "^4.18.0",
        "express-validator": "^7.2.1",
        "ffmpeg-static": "^5.2.0",
        "fs": "^0.0.1-security",
        "jsdom": "^26.1.0",
        "mikro-orm": "^6.4.15",
        "mime-types": "^3.0.2",
        "multer": "^2.0.0",
        "mysql2": "^3.14.0",
        "nanoid": "^5.1.5",
        "node-cron": "^4.1.0",
        "pino": "^9.14.0",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "reflect-metadata": "^0.2.2",
        "sharp": "^0.34.2",
        "source-map-support": "^0.5.21",
        "tmp-promise": "^3.0.3",
        "undici": "^6.21.3",
        "winston": "^3.17.0",
        "winston-graylog2": "^2.1.2",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.4.13",
        "@types/express": "^5.0.1",
        "@types/jsdom": "^21.1.7",
        "@types/mime-types": "^3.0.1",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.15.21",
        "@types/xml2js": "^0.4.14",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.8.3"
    }
}
