{
    "name": "bot-1cc",
    "version": "1.0.0",
    "description": "Bot Discord du 1CC",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "npm run build && node dist/src/index.js",
        "mikro-orm": "mikro-orm-esm",
        "migrate:create": "npm run build && npm run mikro-orm -- migration:create",
        "migrate:up": "npm run build && npm run mikro-orm -- migration:up",
        "migrate:down": "npm run build && npm run mikro-orm -- migration:down"
    },
    "dependencies": {
        "@mikro-orm/core": "^6.4.13",
        "@mikro-orm/migrations": "^6.4.13",
        "@mikro-orm/mysql": "^6.4.13",
        "@mikro-orm/reflection": "^6.4.13",
        "date-fns": "^4.1.0",
        "discord.js": "^14.0.0",
        "dotenv": "^16.0.0",
        "express": "^4.18.0",
        "express-validator": "^7.2.1",
        "mysql2": "^3.14.0",
        "reflect-metadata": "^0.2.2",
        "sharp": "^0.34.1",
        "source-map-support": "^0.5.21",
        "tmp-promise": "^3.0.3",
        "winston": "^3.17.0",
        "winston-graylog2": "^2.1.2",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@mikro-orm/cli": "^6.4.13",
        "@types/express": "^5.0.1",
        "@types/node": "^22.14.1",
        "@types/xml2js": "^0.4.14",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.8.3"
    }
}
